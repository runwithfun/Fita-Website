{
  "name": "fita-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:en": "FITA_LOCALE=en node scripts/build.mjs",
    "test": "node --test test/analytics.test.mjs test/i18n.test.mjs test/build.test.mjs test/acquisition.test.mjs",
    "preview": "FITA_ANALYTICS=0 npm run build && npx --yes serve@14 _site -l 4190",
    "preview:en": "FITA_ANALYTICS=0 npm run build:en && npx --yes serve@14 _site-en -l 4192"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
